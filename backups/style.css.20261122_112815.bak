:root{--navy:#123b75;--teal:#078e89;--mint:#e5fbf6;--ink:#142b4e;--muted:#718096;--paper:#fff;--line:#e5edf4}
*{box-sizing:border-box}html{font-size:14px;-webkit-text-size-adjust:100%;touch-action:pan-y}body{margin:0;font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;color:var(--ink);background:linear-gradient(145deg,#e7f4ff 0%,#f4f7fb 48%,#ffede2 100%);min-height:100vh}button,input,select{font:inherit}button,a{ -webkit-tap-highlight-color:transparent}a{color:inherit;text-decoration:none}.wrap{width:min(100%,480px);margin:auto;padding:14px 14px 92px}.brand{display:flex;align-items:center;gap:10px;margin:5px 3px 16px}.brandmark{width:43px;height:43px;border-radius:14px;background:linear-gradient(145deg,#168fe0,#0b4c9b);color:#fff;display:grid;place-items:center;box-shadow:0 5px 14px #1769a833}.brandmark svg{width:27px;height:27px}.brandname{font-size:22px;font-weight:850;letter-spacing:-.7px;color:#123d79;line-height:1}.brandname small{display:block;font-size:10px;letter-spacing:.4px;margin-top:4px;color:#31547d}.panel,.card{background:#fff;border:1px solid #ffffffd9;border-radius:21px;box-shadow:0 7px 22px #1b47700d}.panel{padding:20px}.hero{position:relative;overflow:hidden;padding:20px;border-radius:24px;background:linear-gradient(115deg,#d8efff,#fff 65%,#e7f8f2);min-height:145px;box-shadow:0 8px 22px #1a477015}.hero h1{font-size:23px;line-height:1.1;margin:0 0 8px;max-width:240px;color:#103a74}.hero p{margin:0;font-size:12px;max-width:225px;color:#385777}.hero-art{position:absolute;right:8px;bottom:8px;width:120px;height:110px;color:#178eae;opacity:.88}.dots{display:flex;gap:5px;margin-top:16px}.dots i{width:6px;height:6px;border-radius:10px;background:#9aafc6;animation:pulse 1.4s infinite}.dots i:nth-child(2){animation-delay:.2s}.dots i:nth-child(3){animation-delay:.4s}@keyframes pulse{50%{opacity:.25;transform:scale(.8)}}.section-head{display:flex;justify-content:space-between;align-items:center;margin:19px 2px 10px}.section-head h2{font-size:16px;margin:0;color:#123d76}.section-head a{font-size:12px;color:var(--teal);font-weight:750}.balances{display:grid;grid-template-columns:1fr 1fr;gap:9px;margin-top:11px}.balance{padding:13px 12px;border-radius:19px;background:#fff;box-shadow:0 5px 18px #204b7110;border:1px solid #fff}.balance .ico{width:34px;height:34px;border-radius:12px;background:#e4f3ff;color:#1676c8;display:grid;place-items:center;margin-bottom:8px}.balance:nth-child(2) .ico{background:#e3fbef;color:#0a9c72}.balance label{display:block;font-size:11px;color:#61758b}.balance strong{font-size:15px;display:block;margin:3px 0 10px;white-space:nowrap}.btn{border:0;border-radius:14px;padding:12px 15px;background:var(--teal);color:#fff;font-weight:750;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px}.btn.full{width:100%}.btn.navy{background:#123b75}.btn.light{background:#eaf4fb;color:#16477d}.btn.outline{background:#fff;border:1px solid #0b9e9b;color:#078e89}.quick{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.quick a{background:#fff;border-radius:16px;padding:13px 5px;text-align:center;box-shadow:0 5px 15px #204b7110;font-size:11px;font-weight:700}.quick svg{display:block;margin:0 auto 7px;width:25px;height:25px;color:#087fba}.products{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.product{background:#fff;border-radius:16px;padding:10px 7px;text-align:center;box-shadow:0 5px 15px #204b7110}.product .pico{height:58px;display:grid;place-items:center;color:#1877b7}.product svg{width:47px;height:47px;stroke-width:1.5}.product b{display:block;font-size:11px;line-height:1.2}.notice{margin-top:15px;background:linear-gradient(100deg,#08a96e,#04c58b);color:#fff;border-radius:17px;padding:13px;display:flex;align-items:center;gap:10px;box-shadow:0 6px 15px #009d7040}.notice svg{width:31px;height:31px;flex:none}.notice b{font-size:13px}.notice small{display:block;font-size:10px;opacity:.9;margin-top:3px}.announcement{background:#fff;border-radius:15px;padding:13px;font-size:12px;display:flex;gap:9px;align-items:center}.bottomnav{position:fixed;z-index:20;bottom:0;left:50%;transform:translateX(-50%);width:min(100%,480px);display:grid;grid-template-columns:repeat(4,1fr);padding:8px 7px calc(8px + env(safe-area-inset-bottom));background:#ffffffed;backdrop-filter:blur(12px);border:1px solid #e7edf4;border-radius:20px 20px 0 0;box-shadow:0 -5px 20px #173c5d12}.bottomnav a{text-align:center;font-size:10px;color:#52657a;padding:3px}.bottomnav svg{display:block;width:23px;height:23px;margin:0 auto 3px}.bottomnav a.active{color:#078e89;font-weight:800}.bottomnav a.active svg{stroke-width:2.6}.field{margin:13px 0}.field label{display:block;font-size:12px;font-weight:750;margin-bottom:7px}.field input,.field select{width:100%;border:1px solid #dce5ed;background:#f8fafc;border-radius:14px;padding:14px 13px;outline:none;color:#142b4e}.field input:focus,.field select:focus{border-color:#0b9e9b;box-shadow:0 0 0 3px #0b9e9b18}.tabs{display:grid;grid-template-columns:1fr 1fr;background:#eff4f8;border-radius:14px;padding:4px;margin-bottom:20px}.tabs button{border:0;background:transparent;padding:11px;border-radius:11px;font-weight:750;color:#52657a}.tabs button.active{background:#078e89;color:white}.flash{padding:11px 13px;background:#fff2e8;color:#9a4a15;border-radius:12px;font-size:12px;margin-bottom:12px}.small{font-size:11px;color:var(--muted);line-height:1.5}.modalback{position:fixed;inset:0;background:#0e203c9c;z-index:50;display:none;align-items:center;justify-content:center;padding:16px}.modalback.show{display:flex}.modal{width:min(100%,410px);background:#fff;border-radius:22px;padding:20px;box-shadow:0 20px 60px #07172c55;animation:pop .2s ease-out}@keyframes pop{from{transform:translateY(12px);opacity:0}to{transform:none;opacity:1}}.modal h2{margin:0 0 16px;font-size:21px}.modalclose{float:right;border:0;border-radius:50%;width:31px;height:31px;background:#eff3f7;font-size:20px}.presets{display:grid;grid-template-columns:repeat(4,1fr);gap:6px;margin:9px 0 15px}.presets button{border:0;border-radius:10px;background:#eff3f8;padding:9px 2px;font-size:10px;font-weight:750;color:#17375e}.txrow{display:flex;justify-content:space-between;padding:12px 0;border-bottom:1px solid var(--line);font-size:12px}.profilehead{text-align:center;padding:23px}.avatar{width:76px;height:76px;border-radius:50%;margin:0 auto 10px;background:#e4f2ff;color:#147bc0;display:grid;place-items:center}.avatar svg{width:44px;height:44px}.menuitem{display:flex;align-items:center;gap:12px;padding:13px 4px;border-bottom:1px solid #edf1f5;font-weight:650;font-size:13px}.menuitem svg{color:#078e89}.equipment-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}.equip{background:#fff;border-radius:17px;padding:13px;text-align:center;box-shadow:0 5px 16px #1b477010}.equip .pico{height:70px;color:#1682b9;display:grid;place-items:center}.equip svg{width:55px;height:55px}.equip h3{font-size:13px;margin:4px 0}.equip strong{display:block;color:#76512b;margin-bottom:9px}.equip .btn{width:100%;font-size:11px;padding:9px}.welcome{background:#e9fbf6;border:1px solid #c7eee2;border-radius:15px;padding:14px;font-size:13px;line-height:1.5;margin:14px 0}.hidden{display:none!important}

.flash.success{background:#e8f8ee;color:#087a37;border:1px solid #a9e5bd}
.flash.error{background:#fff0f0;color:#b42318;border:1px solid #f2b8b5}
